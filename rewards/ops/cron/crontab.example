# Live infra-1 crontab as of decommission (2026-08-05), sanitized.
# Secrets come from /opt/dcai/rewards/.env (mode 600), sourced inline by the
# epoch job. Variables it must define: RPC_URL (direct node RPC, NOT the shared
# gateway — publish-epoch.sh refuses the gateway), PRIVATE_KEY (publisher /
# foundation key), DISTRIBUTOR_ADDRESS, CLAIMS_JSON, OUT_JSON, P2P_AGENT_TOKEN.

# Fleet + explorer lag check, every 5 minutes (see scripts/dcai-status-check.sh)
*/5 * * * * /usr/local/bin/dcai-status-check.sh >> /var/log/dcai-status.log 2>&1

# Rewards epoch publish, every 2 hours. Runs probe -> score -> merkle -> publish
# on-chain with the foundation key, so this MUST run on exactly one server.
0 */2 * * * set -a; . /opt/dcai/rewards/.env; set +a; /opt/dcai/rewards/run-epoch.sh >> /opt/dcai/rewards/cron.log 2>&1

# Admin dashboard regeneration -> /var/www/html/admin/index.html, every minute
* * * * * cd /opt/dcai/rewards/monitor && node gen-dashboard.mjs >> /tmp/dash.log 2>&1

# Fleet health scan -> /var/www/html/admin/health.json, every minute
* * * * * node /opt/dcai/rewards/monitor/health-scan.mjs >> /tmp/health-scan.log 2>&1
